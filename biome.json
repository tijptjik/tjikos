{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.md", "**/llms.txt", "scripts/checks/*.ts", "biome.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "markdown": {
    "formatter": {
      "enabled": true,
      "proseWrap": "always"
    },
    "parser": {
      "frontmatter": true
    }
  }
}
