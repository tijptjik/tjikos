{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "check": {
      "outputs": []
    },
    "demo": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "outputs": [
        "docs/demo.gif"
      ]
    }
  },
  "globalPassThroughEnv": [
    "GOCACHE",
    "GOMODCACHE",
    "GOPROXY",
    "GOSUMDB",
    "GOTOOLCHAIN",
    "VHS_CHROME_PATH",
    "VHS_NO_SANDBOX"
  ]
}
