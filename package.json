{
  "name": "tjikos",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "whatsover": "bun packages/whatsover/src/cli.ts",
    "build": "turbo run build",
    "check": "turbo run check",
    "demo": "turbo run demo --filter=@tjikos/mailtjik",
    "install:local": "bun run build && bash scripts/install.sh --from-build",
    "dev": "bun scripts/run-local.ts",
    "test:local-run": "bun test scripts/tests/run-local.test.ts"
  },
  "devDependencies": {"turbo": "2.5.8"}
}
