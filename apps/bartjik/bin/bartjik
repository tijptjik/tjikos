#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -d "$root/assets" ]]; then root="${BARTJIK_HOME:-$HOME/.local/lib/bartjik}"; fi
export BARTJIK_HOME="$root"
# Retain the native selector as a compatibility alias for existing launchers.
if [[ "${1:-}" == --gtk ]]; then shift; fi
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --config) [[ $# -ge 2 ]] || { echo '--config requires a path' >&2; exit 2; }; export BARTJIK_CONFIG="$(realpath -m -- "$2")"; shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]}"
if [[ $# == 0 ]]; then set -- serve --reserve; fi
case "$1" in --demo|--reserve) set -- serve --reserve "$@" ;; esac
if [[ -x "$root/bin/bartjik-gtk" ]]; then exec "$root/bin/bartjik-gtk" "$@"; fi
if [[ -x "$root/dist/bin/bartjik-gtk" ]]; then exec "$root/dist/bin/bartjik-gtk" "$@"; fi
exec "$root/target/release/bartjik-gtk" "$@"
