#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -f "$root/qml/shell.qml" ]]; then root="${BARTJIK_HOME:-$HOME/.local/lib/bartjik}"; fi
export BARTJIK_HOME="$root"
if [[ "${1:-}" == --gtk ]]; then
    shift
    if [[ -x "$root/bin/bartjik-gtk" ]]; then exec "$root/bin/bartjik-gtk" "$@"; fi
    if [[ -x "$root/dist/bin/bartjik-gtk" ]]; then exec "$root/dist/bin/bartjik-gtk" "$@"; fi
    exec "$root/target/release/bartjik-gtk" "$@"
fi
if [[ -x "$root/bin/bartjik-core" ]]; then exec "$root/bin/bartjik-core" launch "$@"; fi
exec "$root/target/release/bartjik-core" launch "$@"
