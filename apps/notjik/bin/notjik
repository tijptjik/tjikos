#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ ! -f "$root/qml/shell.qml" ]]; then
    root="${NOTJIK_HOME:-$HOME/.local/lib/notjik}"
fi
export NOTJIK_HOME="$root"
if [[ "${1:-}" == --gtk ]]; then
    shift
    if [[ -x "$root/bin/notjik-gtk" ]]; then exec "$root/bin/notjik-gtk" --serve "$@"; fi
    exec "$root/dist/bin/notjik-gtk" --serve "$@"
fi
if [[ "${1:-}" == --gtk-cards ]]; then
    shift
    if [[ -x "$root/bin/notjik-gtk" ]]; then
        exec "$root/bin/notjik-gtk" "$@"
    fi
    exec "$root/dist/bin/notjik-gtk" "$@"
fi
if [[ -x "$root/bin/notjik-core" ]]; then
    exec "$root/bin/notjik-core" launch "$@"
fi
exec "$root/dist/bin/notjik-core" launch "$@"
