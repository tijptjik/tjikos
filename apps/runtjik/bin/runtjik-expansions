#!/usr/bin/env python3
"""Edit Espanso matches while preserving surrounding YAML and checking stale reads."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import sys
import tempfile
import uuid
import yaml


def dictionary():
    return Path(os.environ.get('RUNTJIK_EXPANSIONS_DIR', str(Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'espanso/match')))


def read(path):
    text = path.read_text()
    document = yaml.compose(text)
    if not isinstance(document, yaml.MappingNode):
        return text, None, []
    sequence = next((v for k, v in document.value if k.value == 'matches'), None)
    if not isinstance(sequence, yaml.SequenceNode):
        return text, None, []
    values = yaml.safe_load(text)['matches']
    return text, sequence, values


def entries(root):
    rows = []
    for path in sorted(root.rglob('*')):
        if path.suffix not in ('.yml', '.yaml') or path.name.startswith('_'):
            continue
        text, sequence, values = read(path)
        for index, value in enumerate(values):
            if not isinstance(value, dict) or not isinstance(value.get('trigger'), str) or not isinstance(value.get('replace'), str):
                continue
            rows.append(dict(file=str(path.relative_to(root)), index=index,
                             hash=hashlib.sha256(text.encode()).hexdigest(),
                             trigger=value['trigger'], expansion=value['replace']))
    return sorted(rows, key=lambda r: (r['trigger'].casefold(), r['trigger'], r['file'], r['index']))


def write(path, text):
    # Resolve existing symlinks so an editor does not sever a managed dictionary.
    path = path.resolve()
    fd, temporary = tempfile.mkstemp(prefix='.runtjik-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            if path.exists():
                os.fchmod(output.fileno(), path.stat().st_mode & 0o777)
            output.write(text)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def handle(request):
    root = dictionary()
    if request['action'] == 'list':
        return entries(root) if root.exists() else []
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.runtjik.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        original = request.get('original')
        trigger = (request.get('trigger') or '').strip()
        expansion = request.get('expansion') or ''
        if request['action'] == 'save':
            if not trigger or any(c.isspace() for c in trigger) or not expansion:
                raise ValueError('Enter a trigger without spaces and a nonempty expansion')
            if any(row['trigger'] == trigger and (not original or (row['file'], row['index']) != (original['file'], original['index'])) for row in entries(root)):
                raise ValueError('That trigger already exists')
        if not original:
            if request['action'] != 'save':
                raise ValueError('Select an expansion to delete')
            path = root / ('runtjik-' + uuid.uuid4().hex + '.yml')
            write(path, yaml.safe_dump({'matches': [{'trigger': trigger, 'replace': expansion}]}, allow_unicode=True, sort_keys=False))
            return {}
        relative = Path(original['file'])
        path = root / relative
        if relative.is_absolute() or '..' in relative.parts:
            raise ValueError('Invalid dictionary path')
        text, sequence, values = read(path)
        if hashlib.sha256(text.encode()).hexdigest() != original['hash']:
            raise ValueError('Dictionary changed; cancel and reopen the entry before editing')
        if sequence.flow_style or any(isinstance(event, yaml.AliasEvent) for event in yaml.parse(text)):
            raise ValueError('Edit flow-style or aliased dictionaries in a YAML editor')
        index = original['index']
        node = sequence.value[index]
        if request['action'] == 'delete':
            start = text.rfind('\n', 0, node.start_mark.index) + 1
            end = (text.rfind('\n', 0, sequence.value[index + 1].start_mark.index) + 1
                   if index + 1 < len(values) else sequence.end_mark.index)
            if len(values) == 1:
                text = text[:sequence.start_mark.index] + '[]\n' + text[sequence.end_mark.index:]
            else:
                text = text[:start] + text[end:]
        else:
            changes = []
            for key, value in node.value:
                if key.value in ('trigger', 'replace'):
                    replacement = json.dumps(trigger if key.value == 'trigger' else expansion, ensure_ascii=False)
                    old = text[value.start_mark.index:value.end_mark.index]
                    if old.endswith('\n'):
                        replacement += '\n'
                    changes.append((value.start_mark.index, value.end_mark.index, replacement))
            for start, end, replacement in sorted(changes, reverse=True):
                text = text[:start] + replacement + text[end:]
        yaml.safe_load(text)
        write(path, text)
        return {}


if __name__ == '__main__':
    try:
        print(json.dumps({'ok': handle(json.load(sys.stdin))}))
    except Exception as error:
        print(json.dumps({'error': str(error)}))
