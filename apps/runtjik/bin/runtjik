#!/usr/bin/env bash
set -euo pipefail
# Desktop sessions may omit user-installed application commands.
export PATH="$HOME/.local/bin:$PATH"
source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$source_root/runtjik-core" ]]; then
    export RUNTJIK_HOME="$source_root"
else
    export RUNTJIK_HOME="${RUNTJIK_HOME:-$HOME/.local/lib/runtjik}"
fi
core=("$RUNTJIK_HOME/runtjik-core")
# A failed/live-but-unresponsive app must never authorize closing another window.
if [[ "${1:-}" == close-active ]]; then
    handled="$("$RUNTJIK_HOME/runtjik-gtk" close-target)"
    case "$handled" in
        true) exit 0 ;;
        false) exec hyprctl eval 'hl.dispatch(hl.dsp.window.close())' ;;
        *) echo 'Runtjik did not return a close decision' >&2; exit 1 ;;
    esac
fi
if [[ "${1:-}" == --gtk ]]; then shift; fi
case "${1:-toggle}" in
    toggle|show|close|quit|status|--demo) exec "$RUNTJIK_HOME/runtjik-gtk" "$@" ;;
    --version|version) exec "${core[@]}" version ;;
    desktop-status|refresh|stats|rebuild-counts|check|migrate-config|stop-recording) exec "${core[@]}" "$@" ;;
    *) printf 'Usage: runtjik [toggle|show|close|close-active|quit|refresh|stats|rebuild-counts|check|migrate-config|stop-recording|status|--demo|--version]\n' >&2; exit 2 ;;
esac
