{
  "manifest_version": 2,
  "name": "Runtjik Browser Bridge",
  "version": "0.3.0",
  "description": "Search Firefox or Zen windows, tabs and browsing history from Runtjik.",
  "browser_specific_settings": {
    "gecko": {
      "id": "runtjik-browser@tjikos.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "history"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "icons": {
    "96": "icon.png"
  }
}
