{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hype-whatsover-voice-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "services": [
    {
      "binding": "VOICE",
      "service": "hype-whatsover-prod",
      "entrypoint": "VoiceGateway"
    }
  ],
  "env": {
    "local": {
      "name": "hype-whatsover-voice-local",
      "services": [
        {
          "binding": "VOICE",
          "service": "hype-whatsover-local",
          "entrypoint": "VoiceGateway"
        }
      ]
    },
    "preview": {
      "name": "hype-whatsover-voice-preview",
      "services": [
        {
          "binding": "VOICE",
          "service": "hype-whatsover-preview",
          "entrypoint": "VoiceGateway"
        }
      ]
    }
  }
}
