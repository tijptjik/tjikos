#!/usr/bin/env bash
set -euo pipefail
source_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -x "$source_root/dist/tasktjik-gtk" ]]; then
    export TASKTJIK_HOME="$source_root/dist"
elif [[ -x "$source_root/tasktjik-api" ]]; then
    export TASKTJIK_HOME="$source_root"
else
    export TASKTJIK_HOME="${TASKTJIK_HOME:-$HOME/.local/lib/tasktjik}"
fi
if [[ "${1:-}" != --quickshell ]]; then
    case "${1:-show}" in
        show|--gtk|--demo) exec "$TASKTJIK_HOME/tasktjik-gtk" "${@:2}" "${1:-show}" ;;
    esac
else
    shift
fi
case "${1:-show}" in
    show)
        # Closing a FloatingWindow hides it while Quickshell can stay alive.
        # Reopen that instance before --no-duplicate decides there is nothing to do.
        reopened=false
        if [[ "$(quickshell ipc --path "$TASKTJIK_HOME/qml" call tasktjik reopen 2>/dev/null)" == true ]]; then
            reopened=true
        fi
        # Reuse a normal compositor window without tying its lifetime to Runtjik.
        if command -v hyprctl >/dev/null && command -v jq >/dev/null; then
            address=$(hyprctl -j clients 2>/dev/null | jq -r '.[] | select(.title == "Tasktjik") | .address' | head -n 1) || address=''
            if [[ "$address" =~ ^0x[[:xdigit:]]+$ ]] && {
                hyprctl dispatch "hl.dsp.focus({window=\"address:$address\"})" >/dev/null 2>&1 ||
                hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
            }; then
                exit 0
            fi
        fi
        if [[ "$reopened" == true ]]; then
            exit 0
        fi
        export QT_QUICK_CONTROLS_STYLE=Basic
        exec quickshell --path "$TASKTJIK_HOME/qml" --no-duplicate ;;

    api|connect|enroll|devices|import-json|snapshot|request|state|serve|notify|done|dismiss|snooze|subtask-done|subtask-dismiss|clipboard-image) exec "$TASKTJIK_HOME/tasktjik-api" "$@" ;;
    *) echo 'Usage: tasktjik [show|connect URL [--notifications]|enroll [--notifications]|devices|api|request|state|serve|notify|done|dismiss|snooze|import-json|snapshot]' >&2; exit 2 ;;
esac
