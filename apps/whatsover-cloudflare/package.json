    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@types/node": "^22.15.17",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "4.152.0"
  }
}
