{
  "name": "@tjikos/whatsover-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "bun run build:wasm && wrangler deploy --dry-run",
