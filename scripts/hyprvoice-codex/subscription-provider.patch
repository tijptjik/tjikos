@@ -0,0 +1,28 @@
+package provider
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+)
+
+// CodexHTTPClient identifies Hyprvoice and confines requests to the local proxy.
+func CodexHTTPClient() *http.Client {
+	return &http.Client{
+		Transport:     codexTransport{},
+		Timeout:       90 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return fmt.Errorf("Codex proxy redirects are disabled") },
+	}
+}
+
+type codexTransport struct{}
+
+func (codexTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.Scheme != "http" || r.URL.Host != "127.0.0.1:2455" {
+		return nil, fmt.Errorf("Codex requests must use the local subscription proxy")
+	}
+	r = r.Clone(r.Context())
+	r.Header.Del("Authorization")
+	r.Header.Set("User-Agent", "hyprvoice-codex/1.0.2")
+	return http.DefaultTransport.RoundTrip(r)
+}
