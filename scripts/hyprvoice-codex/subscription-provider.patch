@@ -0,0 +1,32 @@
+package provider
+
+// CodexBaseURL is the local subscription proxy. No public API fallback is used.
+const CodexBaseURL = "http://127.0.0.1:2455"
+
+type CodexProvider struct{}
+
+func (*CodexProvider) Name() string               { return "codex" }
+func (*CodexProvider) RequiresAPIKey() bool       { return false }
+func (*CodexProvider) ValidateAPIKey(string) bool { return true }
+func (*CodexProvider) APIKeyURL() string          { return "" }
+func (*CodexProvider) IsLocal() bool              { return false }
+func (*CodexProvider) DefaultModel(t ModelType) string {
+	if t == Transcription {
+		return "gpt-4o-transcribe"
+	}
+	if t == LLM {
+		return "gpt-6-luna"
+	}
+	return ""
+}
+func (*CodexProvider) Models() []Model {
+	return []Model{
+		{ID: "gpt-4o-transcribe", Name: "Codex transcription", Type: Transcription,
+			SupportsBatch: true, AdapterType: AdapterOpenAI,
+			SupportedLanguages: openaiTranscriptionLanguages,
+			Endpoint:           &EndpointConfig{BaseURL: CodexBaseURL, Path: "/v1/audio/transcriptions"}},
+		{ID: "gpt-6-luna", Name: "Codex Luna cleanup", Type: LLM,
+			SupportsBatch: true, AdapterType: AdapterOpenAI,
+			Endpoint: &EndpointConfig{BaseURL: CodexBaseURL, Path: "/v1/chat/completions"}},
+	}
+}
diff --git a/internal/provider/codex_http.go b/internal/provider/codex_http.go
new file mode 100644
index 0000000..862fb64
--- /dev/null
+++ b/internal/provider/codex_http.go
@@ -0,0 +1,28 @@
+package provider
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+)
+
+// CodexHTTPClient identifies Hyprvoice and confines requests to the local proxy.
+func CodexHTTPClient() *http.Client {
+	return &http.Client{
+		Transport:     codexTransport{},
+		Timeout:       90 * time.Second,
+		CheckRedirect: func(*http.Request, []*http.Request) error { return fmt.Errorf("Codex proxy redirects are disabled") },
+	}
+}
+
+type codexTransport struct{}
+
+func (codexTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.Scheme != "http" || r.URL.Host != "127.0.0.1:2455" {
+		return nil, fmt.Errorf("Codex requests must use the local subscription proxy")
+	}
+	r = r.Clone(r.Context())
+	r.Header.Del("Authorization")
+	r.Header.Set("User-Agent", "hyprvoice-codex/1.0.2")
+	return http.DefaultTransport.RoundTrip(r)
+}
