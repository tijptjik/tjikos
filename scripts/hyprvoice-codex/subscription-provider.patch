@@ -0,0 +1,32 @@
+package provider
+
+// CodexBaseURL is the local subscription proxy. No public API fallback is used.
+const CodexBaseURL = "http://127.0.0.1:2455"
+
+type CodexProvider struct{}
+
+func (*CodexProvider) Name() string               { return "codex" }
+func (*CodexProvider) RequiresAPIKey() bool       { return false }
+func (*CodexProvider) ValidateAPIKey(string) bool { return true }
+func (*CodexProvider) APIKeyURL() string          { return "" }
+func (*CodexProvider) IsLocal() bool              { return false }
+func (*CodexProvider) DefaultModel(t ModelType) string {
+	if t == Transcription {
+		return "gpt-4o-transcribe"
+	}
+	if t == LLM {
+		return "gpt-6-luna"
+	}
+	return ""
+}
+func (*CodexProvider) Models() []Model {
+	return []Model{
+		{ID: "gpt-4o-transcribe", Name: "Codex transcription", Type: Transcription,
+			SupportsBatch: true, AdapterType: AdapterOpenAI,
+			SupportedLanguages: openaiTranscriptionLanguages,
+			Endpoint:           &EndpointConfig{BaseURL: CodexBaseURL, Path: "/v1/audio/transcriptions"}},
+		{ID: "gpt-6-luna", Name: "Codex Luna cleanup", Type: LLM,
+			SupportsBatch: true, AdapterType: AdapterOpenAI,
+			Endpoint: &EndpointConfig{BaseURL: CodexBaseURL, Path: "/v1/chat/completions"}},
+	}
+}
