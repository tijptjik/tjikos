+++ b/internal/llm/codex_test.go
@@ -0,0 +1,42 @@
+package llm
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type codexTransport func(*http.Request) (*http.Response, error)
+
+func (f codexTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func TestCodexUsesOnlyLocalProxyWithoutAPIKey(t *testing.T) {
+	old := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = old })
+	calls := 0
+	http.DefaultTransport = codexTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		if r.Header.Get("User-Agent") != "hyprvoice-codex/1.0.2" {
+			t.Fatal("missing client identification")
+		}
+		if r.URL.String() != "http://127.0.0.1:2455/v1/chat/completions" {
+			t.Fatalf("unexpected destination: %s", r.URL)
+		}
+		if r.Header.Get("Authorization") != "" {
+			t.Fatal("Codex must not send an API credential")
+		}
+		return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(`{"choices":[{"message":{"content":"Synthetic test."}}]}`))}, nil
+	})
+	a, err := NewAdapter(Config{Provider: "codex", Model: "gpt-6-luna", APIKey: "must-not-be-forwarded"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = a.Process(context.Background(), "synthetic test")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if calls != 1 {
+		t.Fatalf("got %d calls", calls)
+	}
+}
