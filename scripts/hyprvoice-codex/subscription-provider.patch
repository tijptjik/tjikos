@@ -0,0 +1,29 @@
+package recording
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestRecorderRequestsRawPCM(t *testing.T) {
+	for _, device := range []string{"", "test-microphone"} {
+		t.Run("device="+device, func(t *testing.T) {
+			r := &recorder{config: Config{
+				SampleRate: 16000,
+				Channels:   1,
+				Format:     "s16",
+				Device:     device,
+			}}
+			// --format selects the sample encoding, not the container. Without
+			// --raw, recent pw-record versions emit AU on stdout, whose header
+			// and big-endian samples cannot be passed to the PCM-to-WAV adapter.
+			want := []string{"--raw", "--format", "s16", "--rate", "16000", "--channels", "1", "-"}
+			if device != "" {
+				want = append(want, "--target", device)
+			}
+			if got := r.buildPwRecordArgs(); !reflect.DeepEqual(got, want) {
+				t.Fatalf("pw-record arguments = %q, want raw PCM arguments %q", got, want)
+			}
+		})
+	}
+}
