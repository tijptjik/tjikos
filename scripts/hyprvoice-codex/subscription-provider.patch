+package config
+
+import "testing"
+
+func TestCodexConfigNeedsNoAPIKey(t *testing.T) {
+	t.Setenv("OPENAI_API_KEY", "must-not-be-used")
+	c := DefaultConfig()
+	c.Notifications.Type = "none"
+	c.Transcription.Provider = "codex"
+	c.Transcription.Model = "gpt-4o-transcribe"
+	c.Transcription.Language = "en"
+	c.LLM.Enabled = true
+	c.LLM.Provider = "codex"
+	c.LLM.Model = "gpt-6-luna"
+	if err := c.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	if c.ToTranscriberConfig().APIKey != "" || c.ToLLMConfig().APIKey != "" {
+		t.Fatal("inherited API key")
+	}
+}
