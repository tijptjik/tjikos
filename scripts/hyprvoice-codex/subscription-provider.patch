--- /dev/null
+++ b/internal/notify/errors_only_test.go
@@ -0,0 +1,46 @@
+package notify
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestErrorsOnlyDesktopNotifications(t *testing.T) {
+	dir := t.TempDir()
+	logPath := filepath.Join(dir, "notifications")
+	// Use a private command stub: this test must never notify the live desktop.
+	if err := os.WriteFile(filepath.Join(dir, "notify-send"), []byte("#!/bin/sh\nprintf '%s\\n' \"$*\" >> \"$HYPRVOICE_TEST_NOTIFICATIONS\"\n"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir)
+	t.Setenv("HYPRVOICE_TEST_NOTIFICATIONS", logPath)
+	messages := make(map[MessageType]Message)
+	for _, def := range MessageDefs {
+		messages[def.Type] = Message{Title: def.DefaultTitle, Body: def.DefaultBody, IsError: def.IsError}
+	}
+	notifier := NewNotifier("errors", messages)
+	for _, mt := range []MessageType{MsgRecordingStarted, MsgTranscribing, MsgLLMProcessing, MsgConfigReloaded, MsgOperationCancelled} {
+		notifier.Send(mt)
+	}
+	if _, err := os.Stat(logPath); !os.IsNotExist(err) {
+		t.Fatalf("routine state changes invoked notify-send: %v", err)
+	}
+	notifier.Send(MsgRecordingAborted)
+	notifier.Send(MsgInjectionAborted)
+	notifier.Error("Synthetic transcription failure")
+	data, err := os.ReadFile(logPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lines := strings.Split(strings.TrimSpace(string(data)), "\n")
+	if len(lines) != 3 {
+		t.Fatalf("got %d error notifications, want 3: %s", len(lines), data)
+	}
+	for i, body := range []string{"Recording Aborted", "Injection Aborted", "Synthetic transcription failure"} {
+		if !strings.Contains(lines[i], "-a Hyprvoice -u critical Hyprvoice Error "+body) {
+			t.Fatalf("error notification %d lost critical urgency or body: %q", i, lines[i])
+		}
+	}
+}
